# Porta, e configurações de CORS
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# SMTP: Google SMTP como padrão
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM=seuemail@gmail.com

# Flag para logar e-mails no console em desenvolvimento em vez de enviar (true/false)
SMTP_DEV_LOG=true

# API Key do Groq, e definição de modelo a ser usado
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b