DATABASE_URL=postgres://upy:upy@localhost:5432/upy
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
# SMTP: 'google' ou 'mailhog' (em produção 'production', sempre força Google)
SMTP_PROVIDER=google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM=seuemail@gmail.com
# Fallback local em dev caso o Google falhe
SMTP_FALLBACK_HOST=localhost
SMTP_FALLBACK_PORT=1025
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
